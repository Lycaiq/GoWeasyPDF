# --- Binarios y artefactos de compilacion ---
# El binario de salida del proyecto
goweasyprint
/bin/

# Binarios generales de Go
*.exe
*.exe~
*.dll
*.so
*.dylib

# Binario generado por go test -c
*.test

# --- Artefactos de pruebas y cobertura ---
*.out
coverage.*
*.coverprofile
profile.cov

# --- Dependencias ---
# Descomenta si quieres no commitear el vendor
# vendor/

# --- Workspace de Go (multi-modulo) ---
go.work
go.work.sum

# --- Variables de entorno y secretos ---
# Nunca subas credenciales al repositorio
.env
.env.*
*.pem
*.key
secrets/

# --- IDEs y editores ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Archivos temporales del sistema ---
/tmp/
*.tmp
*.log

# --- Docker ---
# Dockerfile y .dockerignore viven en el repo a proposito;
# son necesarios para que cualquiera pueda reproducir el build

# --- Artefactos de profiling de Go ---
cpu.prof
mem.prof
